---
/* A person drawn with the people they belong to. The chart is the kit's — the
 * same one Falco and Blazevic draw. The provenance rule is the same too, and
 * the answer is different, which is why the annotation stays here:
 *
 * In the Falco archive an edge can come from a register act that has been read.
 * That used to be the difference: here EVERY relationship came from Michael
 * Mazza's family tree and none had been proved by a record, and the note below
 * said so unconditionally.
 *
 * IT IS NOT TRUE ANY MORE, AND THE NOTE WENT ON SAYING IT. parent-links.tsv
 * carries 99 edges marked «read» and 12 marked «index», and since 9 October
 * 2026 the register-proved people are people, with edges of their own. 106
 * person pages were telling a reader that nothing on them had been proved —
 * including Rosario Nicotra, whose ONLY edge is his son, proved by the act that
 * is the reason this archive knows his name at all.
 *
 * So the note is counted now, per person, from that person's own edges.
 *
 * What can be marked is the person: an ancestor of the two children the archive
 * is for, and whether any record about them has actually been read.
 *
 * Dates for anyone 80 or younger are absent from the data, not hidden here.
 */
import { u } from "../lib/url.js";
import { bySlug } from "../lib/people.js";
import disputed from "../data/disputed.json";
import PersonTree from "@daviddef/archive-kit/components/PersonTree.astro";
import "@daviddef/archive-kit/styles/persontree.css";

const { person: p } = Astro.props;

/* Where a record this archive has read contradicts an edge the tree draws, the
   chart says so ON THE EDGE. The tree is still drawn exactly as given -- it is
   Michael's research and this archive does not silently rewrite it -- but a
   reader should not have to find the prose on another page to learn that the
   line they are looking at is disputed. */
const dis = disputed[p.slug] || {};
const disp = (slug) => dis[slug] || null;

const get = (b) => (p[b] || []).map((e) => ({ ...e, rec: bySlug.get(e.slug) }));
/* Counted from the edges actually drawn, so the sentence cannot outlive the
   fact. «index» and «read» are both a record; «tree» is Michael's assertion. */
const EDGES = ["parents", "spouses", "children", "siblings"]
  .flatMap((b) => (p[b] || []).map((e) => e.via || "tree"));
const proved = EDGES.filter((v) => v === "read" || v === "index").length;
const asserted = EDGES.length - proved;
const parents  = get("parents");
const spouses  = get("spouses");
const children = get("children");
const siblings = get("siblings");

/* Eight of this archive's 593 person pages drew no chart at all, and a page that
   draws nothing tells a reader this archive knows nobody about that person. It is
   not what is true. Each of the eight sits alone in their component because NO
   FAMILY RECORD here names them — checked against families.json directly, id by
   id, not inferred from the empty chart.

   It is not about being living, which was my first guess and wrong: 411 people
   here are presumed living and 405 of them sit in a component with others, so
   withholding dates does not cut anybody out of the chart. Six of the eight are
   presumed living and the self node already says «dates withheld — 80 or
   younger»; the other two died in 1987 and 2017. The sentence is the same for
   all eight because the reason is the same. */
const nothing = !parents.length && !spouses.length && !children.length
  && !siblings.length;

const dates = (r) => {
  if (!r) return "";
  if (r.datesHidden) return "";
  if (r.born && r.died) return `${r.born} – ${r.died}`;
  if (r.born) return `b. ${r.born}`;
  if (r.died) return `d. ${r.died}`;
  return "";
};
const cls = (r, slug) => (disp(slug) ? "disputed " : "") +
                 (r && r.records && r.records.length ? "via-register"
                 : r && r.onSpine ? "via-line" : "via-tree");
const via = (r) => r && r.records && r.records.length ? "tree + a record read"
                 : r && r.onSpine ? "tree — an ancestor" : "family tree";

/* Names repeat relentlessly in these three towns, and the archive refuses to
   merge on a name. Where two people in one row answer to the same name, say so
   — it is usually a dead child's name given again, and it is also exactly how
   a records-matcher invents one person out of two. */
const clash = (rows) => {
  const seen = {};
  for (const r of rows) seen[r.name] = (seen[r.name] || 0) + 1;
  return Object.entries(seen).filter(([, n]) => n > 1).map(([n]) => n);
};
const clashChildren = clash(children);
const clashOther = [...new Set([...clash(siblings), ...clash(parents), ...clash(spouses)])];

/* A disputed edge says so in place of the provenance; a spouse or sibling
   carries the provenance alone. */
const row = (e, mark) => ({
  name: e.name,
  href: u("/people/" + e.slug),
  dates: dates(e.rec),
  cls: cls(e.rec, e.slug),
  mark: mark === false ? undefined
      : mark === "disputed" && disp(e.slug) ? disp(e.slug).short : via(e.rec),
  title: "Recorded by: " + via(e.rec),
});
---
<PersonTree
  self={{ name: p.name, dates: dates(p),
          gen: p.ancGen ? `generation ${p.ancGen} above the children` : "",
          note: p.datesHidden ? "dates withheld — 80 or younger" : "", noteCls: "living" }}
  parents={parents.map((e) => row(e, "disputed"))}
  spouses={spouses.map((e) => row(e, true))}
  children={children.map((e) => row(e, "disputed"))}
  siblings={siblings.map((e) => row(e, false))}
  always
  keys={nothing ? [] : [
    { cls: "line", label: "an ancestor of Mia and Rocco" },
    { cls: "register", label: "a record about them has been read" },
    { cls: "tree", label: "from the family tree, unverified" },
  ]}
  palette={{ bg: "var(--panel)", "node-bg": "var(--ground)", line: "var(--terra)",
             tree: "var(--ink-3)", via: "var(--ink-3)", gen: "var(--terra)" }}
>
  <Fragment slot="notes">
    {nothing && (
      <p class="warn">No family record in this archive names this person &mdash; not as a
        child, not as a spouse, not as a parent. They are held here because the
        tree holds them, and no relationship of theirs is recorded to draw.</p>
    )}
    {/* "Every relationship drawn here" reads as a boast about nothing when none is
        drawn, and it is the same fault as the empty chart: a sentence about a set
        that happens to be empty. */}
    {!nothing && proved === 0 && <p class="warn"><strong>Every relationship drawn here comes from the
    family tree, and not one of them has yet been proved by a record.</strong> That is the honest
    state of this archive for this person: the chart shows what Michael Mazza's tree asserts, and the
    colour tells you only whether anything at all has been read about the person at the other end.
    <a href={u("/method/")}>The method &rarr;</a></p>}
    {!nothing && proved > 0 && asserted > 0 && <p class="warn"><strong>{proved} of the
    {" " + EDGES.length} relationships drawn here have been proved by a record</strong>; the other
    {" " + asserted} come from Michael Mazza's family tree and have not. The colour on each edge says
    which is which, and it is drawn per edge so that one proved link cannot vouch for the rest.
    <a href={u("/method/")}>The method &rarr;</a></p>}
    {!nothing && proved > 0 && asserted === 0 && <p class="warn"><strong>Every relationship drawn
    here has been proved by a record</strong> — {EDGES.length === 1 ? "the one edge on this chart was"
    : `all ${EDGES.length} edges on this chart were`} read out of a register rather than taken from
    the family tree. <a href={u("/method/")}>The method &rarr;</a></p>}
    {clashChildren.length ? (
      <p class="warn"><strong>Two children here carry one name</strong> — {clashChildren.join(", ")}.
      In these towns that is usually not an error: <strong>a child who died was very often replaced
      by a later child given the same name.</strong> It is also exactly how a records-matcher invents
      one person out of two, which is why they are kept apart here and the reader is told.</p>
    ) : null}
    {clashOther.length ? (
      <p class="warn"><strong>More than one person in this row carries the same name</strong> —
      {" " + clashOther.join(", ")}. That is what the source says. <strong>This archive does not merge
      records on a name</strong>, so they are drawn separately even where one duplicated entry is the
      likelier explanation. <a href={u("/open-questions/")}>The 58 names it refuses to merge →</a></p>
    ) : null}
  </Fragment>
  {Object.keys(dis).length ? (
    <figcaption class="disputed-note" slot="after">
      <strong>One or more of the lines above is contradicted by a record this archive has read.</strong>
      <ul>
        {Object.entries(dis).map(([slug, d]) => (
          <li><a href={u("/people/" + slug)}>{slug.replace(/-/g, " ")}</a> — {d.why}</li>
        ))}
      </ul>
      <p>The chart still draws the family tree exactly as it was given. This archive does not
      silently rewrite someone else's research — it marks the edge and shows its working.</p>
    </figcaption>
  ) : null}
</PersonTree>
