---
/* THE FAMILY RIBBON AT THE TOP OF A FAMILY PAGE (David, 27 October 2026): the family's own generations as the story's
   ribbon draws ours, smaller, and under it how our line connects. The drawing is the kit's (FamilyRibbon.astro,
   kit/docs/family-ribbon.md); the data is src/data/family-lines.json, which tools/build_family_lines.py makes from the
   archive's own data, and src/data/direct-line.json, which the kit makes from the story. Nothing here is typed.

   The story's own marriages are NOT passed as `derived`: tools/build_family_lines.py states every connection itself,
   and leaves out any whose party is living, because a family page names no living person (tools/check_familypages.py
   rule 4). The kit's marriageConnections() would put the living generations' marriages back. */
import FamilyRibbon from "@daviddef/archive-kit/components/FamilyRibbon.astro";
import familyLines from "../data/family-lines.json";
import familyFlags from "../data/family-flags.json";
import directLine from "../data/direct-line.json";
import { u } from "../lib/url.js";
const { family } = Astro.props;
/* The cards' mini flags (kit/docs/ribbon-flags.md) are kept out of family-lines.json, whose contract has no `flags`: the
   kit's ribbonflags.py writes them into src/data/family-flags.json, a copy of the cards (tools/build_ribbon_flags.py). A card
   takes its flags only from the copy of ITSELF (same name, slug and places); `npm run check:ribbonflags` fails a stale copy. */
const same = (a, b) => !!a && !!b && ["name", "slug", "origin", "atPlace", "spouseOrigin"].every((k) => (a[k] ?? "") === (b[k] ?? ""));
const bare = familyLines.families.find((f) => f.id === family);
const flagged = familyFlags.families.find((f) => f.id === family)?.cards ?? [];
const fam = bare && { ...bare, cards: (bare.cards ?? []).map((c, i) =>
  same(c, flagged[i]) && flagged[i].flags?.length ? { ...c, flags: flagged[i].flags } : c) };
---
{fam && (
  <section class="blk">
    <FamilyRibbon family={fam} directLine={directLine} personHref={(s) => u(`/people/${s}/`)} u={u} />
  </section>
)}
<style is:global>
  /* The ribbon flags' key and credit line (kit/docs/ribbon-flags.md): kit 1fa6b54's FamilyRibbon builds with no space between
     "(hover for which place)." and "Flags: Flags Atlas, ..." (the story's ribbon keeps it). A space before the credit, here,
     until the kit keeps its own; once it does, the two collapse into one. */
  .fr-fl .flag-credit::before { content: " "; }
</style>
