---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
const done = [
  ["10 Sep 2026", "MyHeritage GEDCOM export", "614 individuals, 212 families, 39 cited sources, 133 images.", "Parsed in full. 15 duplicate records merged on evidence; 58 shared names left deliberately unmerged; 14 disconnected components identified."],
  ["10 Sep 2026", "The 133 tree images", "Signed MyHeritage links, due to expire 16 September 2026.", "All 133 downloaded and stored in the repository, and all 133 published."],
  ["10 Sep 2026", "Component analysis", "Is this one family tree?", "No. It is 14 pieces. The largest holds 479 people; the second holds 111 Piedimonte Etneo Mazza joined to the rest by nothing. Recorded, not papered over."],
  ["10 Sep 2026", "Ancestral reconstruction from the living generation upward", "Rather than downward from an assumed founder.", "Michael Rocco Mazza has 59 recorded ancestors across 9 generations. The four quarters reach 1697, 1821, 1851 and 1879 respectively."],
  ["10 Sep 2026", "Brisbane Catholic Cemeteries register (Nudgee)", "18 surnames swept against the Archdiocese's own deceased register — the cemetery is not in the Brisbane City Council search.", "90 register rows; 19 matched to this archive with plot, register number and exact dates. Corrected the tree in 6 places. Found the four grandparents in consecutive plots V-1026 to V-1029."],
  ["10 Sep 2026", "NAA passenger arrivals index, 1898–1972", "18 surnames swept, then 18 targeted name searches against the National Archives of Australia's voyage-level index.", "Named the ship for 9 of the 18 crossings, including Sebastiano Mazza (Toscana, 4 Oct 1949) and Michele Mazza (Palermo, 21 Apr 1925). Corrected four ports of arrival or embarkation."],
  ["10 Sep 2026", "Antenati — nine annual indexes, three comuni", "Piedimonte Etneo Nati 1877, 1878, 1879 (+supplement), 1880, 1881; Mascali 1879; Giarre 1879. Archivio di Stato di Catania.", "A NULL on Salvatore Mazza in all nine. Five Mazza births found: Antonino and Grazia (1877), Rosaria and Venerio (1879), Gaetano (1880); none at all in 1878, 1881, Mascali or Giarre. Acts 167 and 205 transcribed in full, documenting three Mazza braccianti of Via Terremorte."],
  ["10 Sep 2026", "Queensland BDM historical index", "Free Registry index — deaths to 1996, marriages to 1951, births to 1926. Searched on the FATHER'S and MOTHER'S names, not the person's.", "Six registrations. Proved Michele Mazza (d. 14 Nov 1926) and Rosario Mazza (b. 1899) sons of Salvatore Mazza and Maria Concetta Nicotra, and therefore Sebastiano's brothers. Confirmed Maria Nicotra's own parents, Sebastiano and Domenica as Mary Rosa's parents, and Maria Mazza's 1939 marriage to Rosario Coco."],
];
const notyet = [
  ["Antenati — Piedimonte Etneo, Nati 1875, 1876 and 1882 onward", "Salvatore Mazza, if the year is further out than two.", "Each volume carries its own index, so this is index reads, not volume reads."],
  ["Antenati — Piedimonte Etneo, Matrimoni", "The marriage of Salvatore Mazza and Concetta Greco, c. 1870; and any Rosario Mazza marriage.", "A marriage act names both fathers — the fastest route to Rosario."],
  ["Antenati — the acts behind index entries 164, 168 (1877) and 66 (1880)", "The fathers of Mazza Antonino, Grazia and Gaetano.", "Three more Mazza households for the cost of three crops."],
  ["Antenati / Catania", "Salvatore Mazza, who died at Catania in 1929.", "A large city's registers — a much bigger job."],
  ["Antenati — Catanzaro / Vibo Valentia, Briatico", "The whole Prostamo, Melluso and Anile descent, 1809 onward.", "Would convert eight asserted generations into documented ones."],
  ["Antenati — Reggio Calabria, Scilla", "Arena, Polistena and Donato, 1809 onward.", ""],
  ["National Archives of Australia — the nine remaining crossings", "Domenica Prostamo, March 1951, is not in the index under either surname.", "Nine of eighteen are still unnamed."],
  ["CEMLA — Argentine immigration", "The Buenos Aires Prostamo.", ""],
  ["FamilySearch full-text search", "Piedimonte Etneo and Briatico parish registers.", "The technique that broke the Falco line open."],
];
---
<Base title="What Has Been Read" eyebrow="And what has not"
      dek="A search that found nothing is still a result: it stops the next person repeating it. This page records both what has been done and what is still outstanding.">

  <section class="blk">
    <h2>Done</h2>
    <div class="scroll" style="margin-top:16px">
      <table>
        <thead><tr><th class="m">When</th><th>What</th><th>Scope</th><th>Result</th></tr></thead>
        <tbody>{done.map(([w, t, s, r]) => (
          <tr><td class="m">{w}</td><td>{t}</td><td>{s}</td><td>{r}</td></tr>))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>Not yet read</h2>
    <p class="dek" style="margin:.7rem 0 1.2rem">No Italian civil register has been opened for this
    family. That is the honest headline of this archive on the day it was built.</p>
    <div class="scroll">
      <table>
        <thead><tr><th>Source</th><th>What would be looked for</th><th>Note</th></tr></thead>
        <tbody>{notyet.map(([t, s, n]) => (
          <tr><td>{t}</td><td>{s}</td><td>{n}</td></tr>))}
        </tbody>
      </table>
    </div>
    <p style="margin-top:24px"><a href={u("/open-questions")}>The questions each of these would answer →</a></p>
  </section>
</Base>
