---
/* One page per place, drawn by the kit.

   This file was 85 lines and four archives held the same 85 lines, byte for
   byte. What is left here is the only part that was ever this archive's:
   where the rows come from, and what the page is called. */
import Base from "../../layouts/Base.astro";
import PlacePage from "@daviddef/archive-kit/components/PlacePage.astro";
import { u } from "../../lib/url.js";
import atlas from "../../../public/atlas-data.json";

export function getStaticPaths() {
  return atlas.places
    .filter((p) => p.slug)
    .map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const bits = [p.when, p.fix === "approx" ? "coordinate approximate" : null].filter(Boolean);

/* Some of these places have a page of their own in this archive — what the
   comune is, what its registers hold, and what has been read in them. A place
   page is a list of people; a comune page is the ground they stood on, and a
   reader who lands on one should be able to reach the other. Kept here rather
   than in the kit's component because the list is this archive's, not the
   estate's. */
const TOWN = {
  scilla: "/scilla/", briatico: "/briatico/", "piedimonte-etneo": "/piedimonte-etneo/",
  mascali: "/mascali/", giarre: "/giarre/", riposto: "/riposto/", brisbane: "/brisbane/",
  nudgee: "/nudgee/",
};
const town = TOWN[p.slug];
---
<Base title={p.name}
      eyebrow={bits.join(" · ")}
      dek={p.what || `Everything this archive can put in ${p.name}.`}>
  <PlacePage p={p} u={u} />
  {town && (
    <section class="blk" style="border-bottom:0">
      <p class="note"><strong>{p.name} has a page of its own.</strong> What the comune is, what its
      registers hold, and what this archive has read in them —
      <a href={u(town)}>{p.name} →</a></p>
    </section>
  )}
</Base>
