---
/* The box is one component in @daviddef/archive-kit, shared by all seven
   archives. What stays here is what belongs to this archive: how it describes
   itself, and the things worth trying. */
import Base from "../layouts/Base.astro";
import Search from "@daviddef/archive-kit/components/Search.astro";
import { u } from "../lib/url.js";

const hints = [["Piedimonte", "the foot of Etna"], ["Briatico", "nine Prostamo generations"], ["Scilla", "Arena and Polistena, one town"], ["Nudgee", "the four graves in a row"], ["Toscana", "a ship out of Genoa"], ["1697", "the oldest date in the archive"], ["Surriento", "filed under a shortened name"], ["V-1026", "the first of the four plots"]];
---
<Base title="Search" eyebrow={"Everything this archive can point at, in one box"} dek="The four quarters, the people, the towns, the ships and the graves — searched together. Type without the accents if it is easier.">
  <section class="blk">
    <Search base={u("/")} hints={hints} placeholder="Piedimonte · Briatico · Scilla · Nudgee · Toscana · 1697" />
    <p class="dek" style="margin-top:1.4rem">This searches <strong>what the archive says</strong>,
    not the registers themselves. A name that returns nothing here has not been read yet — which is
    itself worth knowing. <a href={u("/searched/")}>What has already been looked for &rarr;</a></p>
  </section>
</Base>
