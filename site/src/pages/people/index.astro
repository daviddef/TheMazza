---
import Base from "../../layouts/Base.astro";
import FilterTable from "@daviddef/archive-kit/components/FilterTable.astro";
import { u } from "../../lib/url.js";
import { people, span, homeOf } from "../../lib/people.js";
const rows = [...people].sort((a, b) =>
  (a.surname || "zzz").localeCompare(b.surname || "zzz") || a.name.localeCompare(b.name));
const surnames = [...new Set(people.map((p) => p.surname).filter(Boolean))].sort();
const status = (p) => p.died
  ? '<span class="chip doc">death recorded</span>'
  : p.born ? `<span class="chip inf">born ${p.born}</span>`
           : '<span class="chip lore">undated</span>';
---
<Base title="The People" eyebrow="Everyone in the archive"
      dek={`All ${people.length} people in the tree. Only ${people.filter((p) => p.died).length} of them have a death recorded anywhere — the rest are undated rather than necessarily alive.`}>
  <FilterTable
    unit="people"
    columns={[{ label: "Name" }, { label: "Dates", cls: "m" }, { label: "Place" }, { label: "Status" }]}
    facets={[
      { key: "sur", label: "Surname", all: "all surnames",
        options: surnames.map((s) => ({ v: s, label: s })) },
      { key: "dated", label: "Show", all: "everyone", options: [
        { v: "dated", label: "With dates" }, { v: "undated", label: "Undated" }] },
    ]}
    rows={rows.map((p) => ({
      hay: (p.name + " " + (homeOf(p) || "")).toLowerCase(),
      facets: { sur: p.surname || "", dated: (p.born || p.died) ? "dated" : "undated" },
      cells: [
        `<a href="${u("/people/" + p.slug + "/")}">${p.name}</a>`,
        span(p) || "",
        homeOf(p) || "",
        status(p),
      ],
    }))} />
</Base>
