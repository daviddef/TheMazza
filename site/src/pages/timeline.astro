---
/* Every dated thing this archive can actually stand behind, in order.
   Built from the record files rather than written out, so a new reading
   appears here the moment it is recorded. */
import Base from "../layouts/Base.astro";
import Evidence from "../components/Evidence.astro";
import { u } from "../lib/url.js";
import spine from "../data/spine.json";
import scilla from "../data/scilla-reads.json";
import sicilianActs from "../data/sicilian-acts.json";
import qld from "../data/qld-bdm.json";
import ships from "../data/ships.json";
import nudgee from "../data/nudgee.json";

const yearOf = (s) => {
  const m = String(s ?? "").match(/\b(1[5-9]\d\d|20\d\d)\b/);
  return m ? Number(m[1]) : null;
};

const events = [];
const add = (year, quarter, what, detail, level, href) => {
  if (year) events.push({ year, quarter, what, detail, level, href });
};

/* the direct line itself — the only rows not tied to a single document */
for (const p of spine.spine) {
  if (p.living) continue;
  add(p.born, p.surname, `${p.name} is born`, p.birthPlace || "", "family",
      p.slug ? `/people/${p.slug}/` : null);
}

for (const r of scilla) {
  add(yearOf(r.year), "Arena · Polistena",
      r.name, `Scilla, act ${r.act}${r.father ? ` · father ${r.father.split(",")[0]}` : ""}`,
      r.status || "documented", null);
}

for (const a of sicilianActs.acts) {
  add(yearOf(a.year), "Mazza",
      `${a.subject} — ${a.kind}`,
      `Piedimonte Etneo, act ${a.act}${a.father ? ` · father ${a.father}` : ""}`,
      "documented", null);
}

for (const r of qld) {
  add(yearOf(r.date), "Brisbane",
      `${r.name} — ${r.type}`,
      `Queensland register ${r.reg}`, "documented",
      r.who ? `/people/${r.who}/` : null);
}

for (const s of ships) {
  add(yearOf(s.naaDate || s.treeDate), "the crossing",
      `${s.who} lands at ${s.naaPort || "Australia"}`,
      `${s.ship ? `the ${s.ship}` : "ship unrecorded"}${s.naaFrom ? `, out of ${s.naaFrom}` : ""}`,
      s.ship ? "documented" : "family",
      s.slug ? `/people/${s.slug}/` : null);
}

for (const b of nudgee.burials) {
  add(yearOf(b.death), "Nudgee",
      `${b.name} is buried`,
      `plot ${b.plot}${b.registerName && b.registerName !== b.name ? ` · entered as ${b.registerName}` : ""}`,
      "documented", b.slug ? `/people/${b.slug}/` : null);
}

events.sort((a, b) => a.year - b.year || a.what.localeCompare(b.what));

/* group by half-century, which is about the granularity the evidence has */
const bands = [];
for (const e of events) {
  const start = Math.floor(e.year / 50) * 50;
  let band = bands.find(b => b.start === start);
  if (!band) bands.push(band = { start, rows: [] });
  band.rows.push(e);
}
bands.sort((a, b) => a.start - b.start);

const documented = events.filter(e => e.level === "documented").length;
const first = events[0], last = events[events.length - 1];
---
<Base title="Timeline"
  eyebrow={`${events.length} dated events, ${first.year} to ${last.year}`}
  dek="Everything this archive can put a year against, in order — and what kind of thing each one rests on. Built from the record files, so a new reading appears here as soon as it is recorded.">

  <section class="blk">
    <p class="prose">{documented} of these {events.length} rows are a document somebody read. The
    rest are the direct line itself, which the family tree asserts and the records have not yet
    reached — mostly the Prostamo generations at Briatico, where the line runs back to
    <strong>{first.year}</strong> on the strength of a tree rather than a register.
    <a href={u("/briatico-tested/")}>That is being tested →</a></p>

    <div class="scroll" style="margin-top:18px">
      <table>
        <tbody>
          {bands.map(b => (
            <tr>
              <td><a href={`#b${b.start}`}>{b.start}–{b.start + 49}</a></td>
              <td class="mono">{b.rows.length}</td>
              <td class="dim">{b.rows.filter(r => r.level === "documented").length} documented</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {bands.map(b => (
    <section class="blk" id={`b${b.start}`}>
      <h2>{b.start}–{b.start + 49} <span class="dim mono">{b.rows.length}</span></h2>
      <div class="scroll" style="margin-top:14px">
        <table>
          <thead><tr><th>Year</th><th>Quarter</th><th>What</th><th>Where it comes from</th><th></th></tr></thead>
          <tbody>
            {b.rows.map(r => (
              <tr>
                <td class="mono">{r.year}</td>
                <td class="dim">{r.quarter}</td>
                <td>{r.href ? <a href={u(r.href)}>{r.what}</a> : r.what}</td>
                <td class="dim">{r.detail || <span class="dim">—</span>}</td>
                <td><Evidence level={r.level} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="blk">
    <p class="prose dim">Confidence is shown in the <a href={u("/method/#ladder")}>five words</a>
    this archive shares with its six siblings. Every row that says <em>family</em> is a place where
    a document would change the picture. The whole list of what has already been looked for is on
    <a href={u("/searched/")}>Searched</a>.</p>
  </section>
</Base>
