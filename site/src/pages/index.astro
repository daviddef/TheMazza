---
import Base from "../layouts/Base.astro";
import PlaceSpark from "@daviddef/archive-kit/components/PlaceSpark.astro";
import MarriageChart from "@daviddef/archive-kit/components/MarriageChart.astro";
import Descent from "@daviddef/archive-kit/components/Descent.astro";
import spineData from "../data/spine.json";
import people from "../data/people.json";
import { chartGroups } from "../lib/marriedin.js";
import WaysIn from "@daviddef/archive-kit/components/WaysIn.astro";
import Numbers from "@daviddef/archive-kit/components/Numbers.astro";
import P from "../components/P.astro";
import { u } from "../lib/url.js";
import stats from "../data/stats.json";
import places from "../data/places.json";
import searched from "../data/searched.json";
import atlas from "../../public/atlas-data.json";
import { people } from "../lib/people.js";

const p = (n) => places.find((x) => x.name.startsWith(n)) || { n: 0 };
const more = [
  ["/ancestors", "The ancestors of Mia and Rocco", "Sixty-two people across ten generations — counted against the 2,046 there ought to be. Complete for grandparents, five per cent complete by the seventh generation, and one thread at the tenth."],
  ["/the-hundred-and-ten", "The hundred and ten", "The archive's largest open question, answered on the day it was built: a hundred and ten Piedimonte Etneo Mazza who turned out to be the families of Michael Rocco Mazza's great-great-uncles."],
  ["/the-name-line", "The Mazza name line", "Four generations this morning, seven tonight — from Mariano Mazza, born about 1815, to two children born in Brisbane."],
  ["/arena", "The Arena", "Thirty-nine Arena of Scilla in a single unbroken family — the counter-example, and the reason a surname tells you least about a family."],
  ["/lines", "The four quarters", "Michael Rocco Mazza has four grandparents and they came from four different places. Three towns in the south of Italy, and the shipping line that brought all four to one suburb of Brisbane."],
  ["/briatico-tested", "Testing the 1697", "The archive's largest claim, audited: two Prostamo generations proved, four shown to rest on nothing, and a family of sailors the tree had recorded as farmers."],
  ["/briatico", "Briatico", "The Calabrian coastal comune that sent its people to New York, to Buenos Aires and to Brisbane in three separate departures."],
  ["/piedimonte-etneo", "Piedimonte Etneo", "The town on the north-east flank of Etna that gave the family its surname — and the shallowest line of the four."],
  ["/scilla", "Scilla", "Homer's Scylla, and a fishing village on the Strait of Messina. The Arena and the Polistena came from here."],
  ["/crossings", "The crossings", "Eighteen recorded arrivals and departures, in two distinct waves fifty years apart: New York before the Great War, Fremantle and Brisbane after the second."],
  ["/nudgee", "Nudgee", "Thirteen of this family are buried in one Brisbane cemetery — the same ground that holds five of the Falco."],
  ["/name", "The name", "Mazza is one of the commonest surnames in Italy, and it was coined many times over. What that means for anyone searching it."],
  ["/open-questions", "Open questions", "What this archive does not know, written down — including the one identification that would add six generations and a hundred and eleven people."],
];

/* 22 September 2026. Five of the estate's eight archives showed no line on
   their front page and this was one. Compact Spine, mirroring the mapping
   direct-line.astro already uses — except the href, which a compact ladder
   does not take: it links each row to that page's generation anchor, because
   position in a line is unique and a name is not. */
const UNSOURCED_HOME = new Set([9, 10]);
/* THE DESCENT. The compact ladder goes; the kit's Descent row takes its
   place — the couple in two equal columns, the children beneath, the
   brothers and sisters under whichever of the two they belong to.

   people.json records children and siblings per person with a slug, so
   nothing here is derived: the spine row carries the person's own slug and
   both sides are read off their own records. HER siblings come from HER
   record, which is the whole point of the second column.

   The surname band survives the move. Eight Prostamos sit above one Mazza
   because the line passes through a daughter, and build_spine.py derives
   that sentence from the descent itself. */
const P_BY_SLUG = new Map(people.map((q) => [q.slug, q]));
const kinCards = (slug, band) => {
  const rec = slug ? P_BY_SLUG.get(slug) : null;
  return ((rec && rec[band]) || []).map((c) => {
    const full = P_BY_SLUG.get(c.slug);
    const hide = !full || full.living || full.presumedLiving || full.datesHidden;
    return {
      name: c.name,
      href: c.slug && !hide ? `/people/${c.slug}/` : null,
      dates: hide ? "" : [full.born, full.died].filter(Boolean).join("\u2013"),
    };
  });
};
const spineRows = spineData.spine.map((g) => {
  const hers = ((P_BY_SLUG.get(g.slug) || {}).spouses || [])[0] || null;
  return {
    gen: g.gen,
    era: [g.born, g.died].filter(Boolean).join(" \u2192 ") || undefined,
    name: g.name,
    href: g.slug && !g.living ? `/people/${g.slug}/` : "",
    living: !!g.living,
    via: g.via || "",
    born: g.born ? String(g.born) : "",
    died: g.died ? String(g.died) : "",
    place: g.birthPlace || g.deathPlace || "",
    spouse: g.spouse || "",
    spouseHref: g.spouseSlug && !g.living ? `/people/${g.spouseSlug}/` : null,
    children: kinCards(g.slug, "children"),
    hisSiblings: kinCards(g.slug, "siblings"),
    herSiblings: kinCards(hers && hers.slug, "siblings"),
    hisLabel: String(g.name).split(" ")[0] + "\u2019s",
    herLabel: g.spouse ? String(g.spouse).split(" ")[0] + "\u2019s" : "Theirs",
    weak: UNSOURCED_HOME.has(g.gen),
    weakNote: "This generation rests on the family tree alone.",
  };
});
---
<Base title="The Mazza Archive" bare={true}>
  <figure class="fhero">
    <img src={u("/hero/scilla-strait.jpg")} alt="Scilla on the Strait of Messina at dawn, with Etna across the water" />
    <figcaption class="cap">
      <div class="kick">A family history, kept honestly</div>
      <h1>Three towns, one strait, and a suburb of Brisbane.</h1>
      <p class="sub">Piedimonte Etneo · Briatico · Scilla · New York · Buenos Aires · Brisbane —
      a family assembled from three corners of the Italian south, and the ships that carried it.</p>
    </figcaption>
  </figure>

  <section class="blk">
    <p class="lede">This is an archive of <strong>the Mazza of Brisbane</strong> — and of the three
    southern Italian towns they came out of, none of which had heard of the other two. It is not a
    pedigree: of the {stats.people} people recorded here, all but a handful never continued the line.
    Only {stats.withDeath} of them have a death recorded anywhere — which is a measure of how much of
    this tree is still undated rather than of who is still alive.</p>
    <blockquote>
      This archive opened with the Mazza name reaching back <strong>four generations</strong> and
      stopping at a man with no dates at all. One day in the Sicilian registers took it to
      <strong>seven generations</strong> and <a href={u("/the-name-line/")}>Mariano Mazza and Maria
      Catalano</a>, and joined <a href={u("/the-hundred-and-ten/")}>a hundred and ten cousins</a> to
      the line — every step a document.
      <br /><br />
      The same day cost the archive its other headline. The Calabrian
      <a href={u("/briatico/")}>Prostamo</a> were said to run nine generations to <strong>1697</strong>.
      Audited, they are <a href={u("/briatico-tested/")}>documented to a sailor dead before 1886</a>,
      and <strong>asserted for four generations above him</strong>.
    </blockquote>
  </section>

  
  <p class="lede" style="margin-top:14px">
    It is a public archive with one rule: <b>a living person is named and nothing more</b> — and
    dates are withheld for anyone eighty or younger, living or not. And a second rule,
    which is harder: <b>every claim says how well it is known</b>.
    <span class="chip doc" style="padding:2px 8px;font-size:10px">Documented</span>
    <span class="chip inf" style="padding:2px 8px;font-size:10px">Inferred</span>
    <span class="chip lore" style="padding:2px 8px;font-size:10px">Family lore</span>
  </p>

  <WaysIn doors={[
    { href: u("/lines/"), name: "The four quarters", blurb: "Four families out of three towns six hundred kilometres apart — Mazza, Prostamo, Arena, Polistena — and where each of them met the others.", cta: "Compare them →" },
    { href: u("/briatico-tested/"), name: "A claim, tested", blurb: "The Prostamo were said to reach 1697. The audit shows what is documented, what is asserted, and by a tree already wrong by six years elsewhere.", cta: "The audit →" },
    { href: u("/nudgee/"), name: "Four plots in a row", blurb: "All four of Michael Rocco Mazza's grandparents lie in consecutive plots V-1026 to V-1029, having arrived on four different sailings.", cta: "The register →" },
  ]} />
  <section class="feat">
    <h2 style="margin-top:6px">Where this family can actually be put</h2>
    <p class="dek" style="margin-top:10px">Calabrian towns on one side of the strait, <strong>four Sicilian comuni within ten kilometres</strong> on the other, and a Brisbane parish where the quarters met. <strong>Every dot is a place this archive can put a named person in, and its size is how many stand there.</strong> The biggest are labelled; the colours are this archive's own regions. The coast and the borders under them are real — Natural Earth, clipped to this frame — so a dot can be read as somewhere rather than as a position in an empty box.</p>
  <PlaceSpark places={atlas.places} href={u("/atlas/")}
              label={`${atlas.places.length} places, two Calabrian towns, one Sicilian, and a Brisbane parish`} />
  </section>


<section class="blk">
    <h2>Where they came from</h2>
    <p class="dek" style="margin:.7rem 0 1.4rem">Four grandparents, three towns, and about six hundred
    kilometres of coast between the furthest two. Nothing in the Italian record joins these families
    to each other. They were joined in Queensland.</p>
    <div class="grid two">
      <a class="cardlink" href={u("/briatico/")}>
        <div class="nm">Briatico</div>
        <div class="alt">Vibo Valentia, Calabria · {p("Briatico").n} events · from 1697</div>
        <p class="txt">Prostamo, Melluso, Anile, Barbuto, Ventrice. A comune on the Tyrrhenian coast
        that sent people to New York, to Buenos Aires and to Brisbane in three separate departures.</p>
      </a>
      <a class="cardlink" href={u("/scilla/")}>
        <div class="nm">Scilla</div>
        <div class="alt">Reggio Calabria · {p("Scilla").n} events · from 1821</div>
        <p class="txt">Arena, Polistena, Donato. The rock and the fishing quarter at the northern
        gate of the Strait of Messina — the whirlpool of the <em>Odyssey</em>.</p>
      </a>
      <a class="cardlink" href={u("/piedimonte-etneo/")}>
        <div class="nm">Piedimonte Etneo</div>
        <div class="alt">Catania, Sicily · {p("Piedimonte").n} events · from 1879</div>
        <p class="txt">Mazza, Nicotra. Literally <em>the foot of the mountain</em>: a town on the
        north-east flank of Etna, and the origin of the surname this archive is named for.</p>
      </a>
      <a class="cardlink" href={u("/nicotra/")}>
        <div class="nm">The Nicotra</div>
        <div class="alt">the maternal Sicilian line · four comuni</div>
        <p class="txt">Four days ago this line was <strong>two names on a Queensland death
        certificate</strong>. It now reaches generation six on both sides, across forty-three read
        index years — and the man it is named for is still missing.</p>
      </a>
      <a class="cardlink" href={u("/mascali/")}>
        <div class="nm">Mascali</div>
        <div class="alt">Catania, Sicily · opened 21 Sep 2026 · from 1820</div>
        <p class="txt">Where <strong>Maria Nicotra was born on 8 December 1875</strong>, at half past
        nine in the evening — found after fourteen years had been read in the wrong town. Etna
        swallowed the place whole in 1928.</p>
      </a>
      <a class="cardlink" href={u("/giarre/")}>
        <div class="nm">Giarre</div>
        <div class="alt">Catania, Sicily · opened 21 Sep 2026 · 808 volumes</div>
        <p class="txt">The town a document names and eleven of its own years contradict — until its
        <strong>first</strong> year was opened. <strong>1820 holds two untitled Nicotra
        households</strong>, and one of the fathers is called Rosario.</p>
      </a>
      <a class="cardlink" href={u("/riposto/")}>
        <div class="nm">Riposto</div>
        <div class="alt">Catania, Sicily · opened 21 Sep 2026 · separate since 1821</div>
        <p class="txt">The lower town, fifteen hundred metres from Giarre and registering separately
        for seventy years. Its 1844 marriage Tavola holds <strong>a Nicotra born at Giarre and
        registering his children here</strong> — the shape the whole search had only guessed at.</p>
      </a>
      <a class="cardlink" href={u("/brisbane/")}>
        <div class="nm">Brisbane</div>
        <div class="alt">Queensland · {p("Brisbane").n} events · from 1925</div>
        <p class="txt">Where the four lines met. Thirteen of them lie at
        <a href={u("/nudgee/")}>Nudgee</a> — the same cemetery as the Falco.</p>
      </a>
    </div>
  </section>

  <section class="blk">
    <h2>Elsewhere in the archive</h2>
    <div class="grid two" style="margin-top:1rem">
      {more.map(([href, t, d]) => (
        <a class="cardlink" href={u(href)}>
          <div class="nm">{t}</div>
          <p class="small" style="margin-top:.4rem">{d}</p>
        </a>
      ))}
    </div>
  </section>

  
<section class="blk">
  <section class="blk">
    <h2>The line, ten generations</h2>
    <p class="dek">Back to the 1690s in Calabria, with the two generations that rest on the family
    tree alone marked where they fall.</p>
    <Descent rows={spineRows} u={u} archiveKey="mazza" />
    <p class="cap" style="margin-top:14px"><a href={u("/direct-line/")}>The full spine →</a></p>
  </section>

  <h2>The families who married in</h2>
  <p class="dek">Every surname this archive holds, ranked. Each is here because a person married a person.
  <a href={u("/marriages/")}>The marriages, in full →</a></p>
  <MarriageChart groups={chartGroups} subject="Mazza" unit="people this archive names" />
</section>

<section class="blk">
    <h2>What this archive has established</h2>
    <div class="grid two" style="margin-top:1rem">
      <div class="card">
        <h3>A claim, tested</h3>
        <p>The Prostamo were said to reach <strong>1697</strong>. They are documented to
        <strong>Domenico Prostamo, a sailor of Briatico</strong> dead before 1886 — and asserted, by a
        tree already shown to be six years out elsewhere, for four generations above him.
        <a href={u("/briatico-tested/")}>The audit →</a></p>
      </div>
      <div class="card">
        <h3>Four plots in a row</h3>
        <p>All four of Michael Rocco Mazza's grandparents — born in three towns six hundred
        kilometres apart, arrived on four different sailings — lie in <strong>consecutive plots
        V-1026 to V-1029</strong> at Nudgee. <a href={u("/nudgee/")}>The register →</a></p>
      </div>
      <div class="card">
        <h3>Nine ships, named</h3>
        <p>The family tree recorded eighteen crossings and not one vessel. The National Archives
        passenger index named nine of them — the <em>Toscana</em>, the <em>Surriento</em>, the
        <em>Roma</em>, the <em>Palermo</em>. <a href={u("/crossings/")}>The crossings →</a></p>
      </div>
      <div class="card">
        <h3>The hundred and ten, joined</h3>
        <p>The export arrived as fourteen disconnected pieces, the second holding
        <strong>110 Piedimonte Etneo Mazza attached to this family by nothing</strong>. Five register
        acts proved them the descendants of Salvatore's brothers.
        <a href={u("/the-hundred-and-ten/")}>The argument →</a></p>
      </div>
      <div class="card">
        <h3>Fifty-eight names it refuses to merge</h3>
        <p>Four men called Rosario Mazza, four called Giuseppe Arena, none with a date between them.
        The archive keeps them apart rather than inventing a descent.
        <a href={u("/method/")}>The method →</a></p>
      </div>
    </div>
  </section>

  <section class="blk" style="border-bottom:0">
    <div class="lab">A standing rule</div>
    <h2 style="margin-top:.4rem">Dates are withheld for anyone {stats.ageThreshold} or younger</h2>
    <p class="dek" style="margin-top:.8rem">Everyone in this tree is written up in full — name,
    places, family, photographs, records. But <strong>{stats.datesHidden} people</strong> who would be
    {stats.ageThreshold} or younger today, and whose death is not recorded, have their
    <strong>dates withheld</strong>. Those dates are stripped in the build, not hidden by the page:
    they are not in the HTML and not recoverable from this site. A removal request is honoured within
    days, without argument and without requiring a reason. <a href={u("/method/")}>The method →</a></p>
  </section>

  <Numbers rows={[
    [stats.people, "people published across the four quarters", u("/people/")],
    [stats.earliest, "the earliest year this archive reaches — and it rests on a tree, not a register", u("/briatico-tested/")],
    [stats.households, "households reconstructed", u("/households/")],
    [stats.families, "families named", u("/families/")],
    [places.length, atlas.stats.unplaced
      ? `places named, ${atlas.places.length} of them on the map`
      : `places named, every one of them on the map \u2014 ${atlas.stats.approx} on an approximate coordinate`,
      u("/atlas/")],
    [searched.length, "searches that found nothing, written down anyway", u("/searched/")],
  ]} />

  <section class="blk" style="border-bottom:0">
    <h2>What is still missing</h2>
    <p class="dek">Written down with the document that would settle each one, and where that
    document is — because <strong>a question with no test beside it is a wish, not a research
    plan</strong>. The deepest claim in the archive, the Prostamo line to 1697, rests on a tree that
    has already been shown wrong by six years elsewhere and is marked accordingly.
    <a href={u("/open-questions/")}>Open questions →</a></p>
    <p class="small" style="margin-top:1rem">Nothing here is taken on trust because it appears in a
    family tree. Where a record has been seen, it is cited; where it has not, the claim is marked.
    See <a href={u("/method/")}>Method</a>.</p>
  </section>
</Base>
