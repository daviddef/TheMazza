---
/* What this archive does not know, and what would settle each one.
 *
 * Two hundred lines of prose lived here — an inline array for some questions
 * and five hand-written blocks for others — which meant they could not be
 * counted or filtered, and, worse, that nobody came back to them. Three were
 * headed ANSWERED and still sat in the same undifferentiated list as the open
 * ones, and two questions answered on 20 September were never added at all.
 *
 * They are data now: data/questions.tsv, rendered by the kit's Questions
 * component, which has been waiting since September for an archive to do the
 * extraction. Its own comment says that extraction «is research work belonging
 * to each archive rather than something to guess at from outside», and that is
 * right: only this archive knows which of its own questions are still open.
 */
import Base from "../layouts/Base.astro";
import Questions from "@daviddef/archive-kit/components/Questions.astro";
import { u } from "../lib/url.js";
import stats from "../data/stats.json";
import questions from "../data/questions.json";
import unresolved from "../data/unresolved.json";
import nameEvidence from "../data/name-evidence.json";

const open = questions.filter((q) => q.state === "open");
const answered = questions.length - open.length;
---
<Base title="Open Questions" eyebrow={`${open.length} open, ${answered} answered`}
      dek="Written down, with the document that would settle each one and where that document is. A question with no test beside it is a wish, not a research plan.">

  <section class="blk">
    <div class="grid g3">
      <div class="stat"><div class="n">{open.length}</div><div class="l">still open</div></div>
      <div class="stat"><div class="n">{answered}</div><div class="l">answered and kept</div></div>
      <div class="stat"><div class="n">{unresolved.length}</div><div class="l">shared names unmerged</div></div>
    </div>
    <p class="note" style="margin-top:20px"><strong>The answered ones stay.</strong> A question that
    vanishes when it is settled leaves a reader unable to tell a thing that was never asked from a
    thing that was asked and closed — and it hides the shape of the mistakes, which is usually the
    most useful part. Every row below carries the record that settled it, or the record that would.</p>
  </section>

  <section class="blk">
    <Questions rows={questions} u={u} unit="questions" />
  </section>

  <section class="blk" style="border-bottom:0">
    <h2>The names this archive refuses to merge</h2>
    <div class="prose" style="margin-top:1rem">
      <p><strong>{unresolved.length} names</strong> are carried by more than one person in the export and
      have not been joined. That is not an oversight. Surname endogamy at Scilla is an observed fact —
      the 1913 marriage index alone has Bueti marrying Bueti, Cambareri marrying Cambareri, Larizza
      marrying Larizza and Vizzari marrying Vizzari — and a man taking a second wife of the same rare
      surname is exactly the sort of thing that happens there.</p>
      <p>So the rule is: <strong>flag the duplicate, name the test that would settle it, do not merge.</strong>
      The reasoning for each is on <a href={u("/components/")}>The Pieces</a>, and the
      {nameEvidence.length} where a record has since spoken are on <a href={u("/name/")}>The Name</a>.</p>
    </div>
  </section>
</Base>
