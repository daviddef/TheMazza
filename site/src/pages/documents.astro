---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { dead } from "../lib/people.js";
import Gallery from "@daviddef/archive-kit/components/Gallery.astro";
import stats from "../data/stats.json";
const withPhotos = dead.filter((p) => p.photos && p.photos.length)
  .sort((a, b) => (a.born || 9999) - (b.born || 9999));
const n = withPhotos.reduce((a, p) => a + p.photos.length, 0);
/* HELD is what the archive keeps; n is what reaches a reader. This sentence
   read «Of 133 images, all {n} now appear here» — a typed total beside a
   counted one, agreeing by luck. They were never equal: three of the 133 hang
   off duplicate xrefs that build.py merges away, so the page was telling a
   reader that every image appears while three did not, and no gate asked.
   Both numbers are counted now and the gap is explained rather than hidden. */
const HELD = stats.photos;   // build.py counts data/photo-manifest.json into stats

/* THIS PAGE IS A GALLERY UNDER A DOCUMENTS LABEL. It holds photographs grouped
   by the person they show, out of a family tree export - not primary sources
   reproduced whole, which is what the other three archives put here. So it
   draws with the gallery component, and gets the lightbox that goes with it,
   because an unidentified family photograph is exactly the thing somebody needs
   to see at full size before they can tell you who is in it.

   The alt text is the person's NAME, which is the fault the gallery component
   names: it describes the subject to somebody who cannot see the image without
   describing the image. It is left as the archive wrote it rather than invented
   here - a caption for a photograph nobody has identified is not mine to write. */
const sheet = withPhotos.flatMap((p) => p.photos.map((f, i) => ({
  src: u("/plates/" + f),
  alt: p.name,
  title: p.name + (p.photos.length > 1 ? ` (${i + 1} of ${p.photos.length})` : ""),
  what: [p.born, p.died].filter(Boolean).join("\u2013") + (p.birthPlace ? ` \u00b7 ${p.birthPlace}` : ""),
  href: "/people/" + p.slug,
  hrefLabel: "Who this is",
})));
---
<Base title="Documents" eyebrow={`${n} images, ${withPhotos.length} people`}
      dek="The photographs and papers held in the family's own tree, saved down before the links expired.">

  <p class="note">These came out of the MyHeritage export as signed links that were due to expire on
  <strong>16 September 2026</strong>. They were downloaded on 10 September and are now held in the
  repository, so the archive no longer depends on a URL that dies. <strong>{n}</strong> of the
  {" "}<strong>{HELD}</strong> held here appear below.{HELD > n && (<> The other {HELD - n} hang off
  duplicate records the export merges away, and each says in the manifest why it is not shown — one
  is an exact copy of an image that IS shown, and the other two are
  <a href={u("/open-questions/")}> one photograph filed under two people's names</a>.</>)}</p>
  {/* «Of 133 images, all {n} now appear here» carried a typed 133 beside a
      counted {n}. They agree today. On the day they stop agreeing the sentence
      reads «Of 133 images, all 140 now appear here» and contradicts itself in
      eleven words. The completeness claim needs a total this page cannot see —
      data/photo-manifest.json is outside Astro's root — so check_plates.py
      owns it instead: it counts the manifest and fails if a declared image
      does not reach a page. The claim is the same, and a gate holds it up
      rather than a number somebody remembered. */}

  <p class="note" style="margin-top:18px">Almost none of these are captioned in the tree. Who is in
  them, when, and where is mostly unknown — and family photographs are exactly the thing a relative
  can identify in seconds. <strong>Corrections and identifications are the most valuable thing you can
  send.</strong></p>

  <Gallery rows={sheet} u={u} unit="images" />

</Base>
