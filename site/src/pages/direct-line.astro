---
import Base from "../layouts/Base.astro";
import P from "../components/P.astro";
import Spine from "@daviddef/archive-kit/components/Spine.astro";
import { u } from "../lib/url.js";
import spineData from "../data/spine.json";
const spine = spineData.spine;
const kids = spineData.children;

/* THE AUDIT WAS IN THE NOTE AT THE TOP AND NOWHERE ON THE ROWS. Four
   generations - 1785, 1760, 1726, 1697 - rest on the family tree alone, and a
   reader who scrolled past the note met them looking exactly like the six that
   are documented. The shared spine marks each of them where it is. */
const UNSOURCED = new Set([6, 7, 8, 9]);
const rows = spineData.spine.map((g, i) => ({
  gen: g.gen, name: g.name,
  href: g.living ? null : `/people/${g.slug}`,
  living: !!g.living,
  born: g.born, bornPlace: g.birthPlace,
  died: g.died, diedPlace: g.deathPlace,
  spouse: g.spouse,
  /* «and why no links for the wives?» — 22 September. The husband was a
     link and his wife was text, on every one of the ten generations, and
     people.json has had her slug the whole time. Suppressed where she is
     living, exactly as the husband's own href is on the line above. */
  spouseHref: g.spouseSlug && !g.living ? `/people/${g.spouseSlug}/` : null,
  weak: UNSOURCED.has(g.gen),
  weakNote: UNSOURCED.has(g.gen)
    ? `This generation rests on the family tree alone. The archive has documented the descent
       down to Domenico Prostamo and no further up.
       <a href="${u("/briatico-tested/")}">Testing the 1697 &rarr;</a>`
    : "",
  note: [
    !g.living && !g.birthPlace && !g.deathPlace
      ? "No place is attached to this generation; they are known from the record of the generation below."
      : "",
    g.burialPlace ? `Buried at ${g.burialPlace}.` : "",
  ].filter(Boolean).join(" "),
}));
---
<Base title="The Spine" eyebrow="Eleven generations"
      dek="The longest descent the family tree asserts: from a man said to be born at Briatico in 1697 to two children born in Brisbane. Its top four generations carry no source — see Testing the 1697.">

  <p class="note">This is not the Mazza line — for that see <a href={u("/the-name-line/")}>the Mazza
  name line</a>, which is documented at every Sicilian step. This is the <strong>longest</strong>
  line, and it belongs to the <a href={u("/briatico/")}>Prostamo of Briatico</a>.
  <strong>Read it with the audit beside it:</strong> the archive has documented this descent back to
  Domenico Prostamo, and the four generations above him — 1785, 1760, 1726, 1697 — rest on the family
  tree alone. <a href={u("/briatico-tested/")}>Testing the 1697 →</a></p>

  <div class="stack" style="margin-top:38px">
    <Spine rows={rows} u={u} />

    <div class="linerow">
      <div>
        <div class="lab">Generation {spine.length + 1}</div>
        <div style="font-size:26px;line-height:1.15;margin-top:8px">
          {kids.map((c) => c.name).join(" · ")}
        </div>
        {/* THESE ARE LIVING CHILDREN AND THIS LINE GAVE THEIR BIRTH YEARS.
            The rule this estate keeps is that a living person gets a name
            and a relationship and nothing else — no dates, no places — and
            it is kept hardest for children. Removed; the sentence beside
            it already says what the reader needs, which is that they are
            the generation below. */}
      </div>
      <div>
        <p class="qw">The two children this archive was assembled for. Between them and
        <P n="Franco Antonino Prostamo" /> of Briatico there are <strong>ten</strong> generations, three
        countries and about sixteen thousand kilometres.</p>
      </div>
    </div>
  </div>

  <section class="blk" style="margin-top:40px">
    <h2>Where it stops, and why</h2>
    <p class="dek" style="margin-top:.8rem">Above <P n="Franco Antonino Prostamo" /> the tree is empty.
    He was born about 1697, which puts his own baptism in a parish register kept at Briatico under the
    Kingdom of Naples — well before civil registration began there in 1809. Nothing above him has been
    looked for yet, and the archive should not pretend otherwise.
    <a href={u("/open-questions/")}>What is being looked for →</a></p>
  </section>
</Base>
