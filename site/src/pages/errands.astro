---
/* What this archive has asked of other people, and what it still needs to ask.
 *
 * Written 9 October 2026 because this was the one page of the estate's eight
 * that Mazza lacked, and the asks it would hold already existed: a drafted
 * request to the Comune di Scilla in notes/requests/, and three more marked
 * blocked on the work list (rows 9, 59, 158), none of them visible to a reader.
 *
 * GROUPED BY DOOR, the way Booyzen groups, because every ask here ends at one
 * institution that holds a record and does not publish it. The grade is a state
 * the archive can honestly claim: «Written, no send recorded» and «Not written».
 * Nothing is recorded as sent or answered, and the page says so rather than
 * implying a wait that has not begun.
 *
 * Rendered by the kit's Errands component; the data is data/errands.json.
 */
import Base from "../layouts/Base.astro";
import Errands from "@daviddef/archive-kit/components/Errands.astro";
import { u } from "../lib/url.js";
import er from "../data/errands.json";

/* The component passes every link through the archive's base-path helper, which is
   right for /sources/ and wrong for https://antenati.cultura.gov.it/: it produced
   /TheMazza/https://antenati... and the kit's link gate said so. An absolute URL
   is left alone. */
const link = (p) => (/^https?:\/\//.test(p) ? p : u(p));
const COLOUR = { written: "#1E5F8C", unwritten: "#7A7A7A" };
const groups = er.doors.map((d) => ({
  label: d.where,
  note: d.why,
  rows: d.asks.map((a) => ({
    what: a.what, ref: a.ref, why: a.why, ask: a.ask, draft: a.draft,
    stateLabel: a.stateLabel, colour: COLOUR[a.state], links: a.links,
  })),
}));
const asks = groups.reduce((n, g) => n + g.rows.length, 0);
const written = groups.reduce((n, g) => n + g.rows.filter((r) => r.draft).length, 0);
---
<Base title="Errands"
      eyebrow={`${groups.length} doors · ${asks} asks · ${written} written out, none recorded as sent`}
      dek="What this archive cannot get by searching: records a comune, a diocese or a state archive holds and does not publish. Each needs a letter or an order, and this page is what would go in it.">

  <section class="blk">
    <h2>Why this page exists</h2>
    <div class="prose" style="margin-top:1rem">
      <p>{er.note}</p>
      <p>If you are near any of these offices, or can write Italian to one of them, the references below
        are the ones this archive has checked. <a href={u("/sources/")}>Sources &rarr;</a> ·
        <a href={u("/open-questions/")}>Open questions &rarr;</a> · <a href={u("/worklist/")}>The work list &rarr;</a></p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="blk">
      <h2>{g.label}</h2>
      <p class="note" style="margin-top:.6rem">{g.note}</p>
      <div style="margin-top:1rem"><Errands groups={[{ rows: g.rows }]} u={link} html={false} /></div>
    </section>
  ))}
</Base>
