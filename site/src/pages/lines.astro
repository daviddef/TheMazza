---
import Base from "../layouts/Base.astro";
import P from "../components/P.astro";
import { u } from "../lib/url.js";
import quarters from "../data/quarters.json";
import documented from "../data/documented-line.json";
import walls from "../data/walls.json";
import { FURTHEST_KM } from "../lib/distance.js";
import { words, Words } from "../lib/words.js";
import BranchRivers from "@daviddef/archive-kit/components/BranchRivers.astro";
import { ledger } from "@daviddef/archive-kit/lib/lines.js";
import lines from "../data/lines.json";
import people from "../data/people.json";
const stopsShort = quarters.filter((q) => !q.line[0].born).sort((a, b) => a.line.length - b.line.length)[0];
const anchors = Object.entries(documented).sort((a, b) => b[1].up.length - a[1].up.length);
const beyond = anchors.reduce((n, [, v]) => n + v.up.length, 0);
const below = anchors.reduce((n, [, v]) => n + (v.down || []).length, 0);
/* THE DRAWING (25 October 2026). The four quarters as the kit's lines figure: one lane per grandparent's chain, each
   with a status that says how far back its evidence reaches, and under the lanes the people who are on none of them.
   The data is written by tools/build_lines.py from quarters.json, walls.json, components.json and people.json, never by
   hand; tools/checklines.py (npm run check:lines) holds it to its own claims. Every number printed here comes from
   ledger(), or from the data that made it. The names are the dead people's alone: a living person is on no lane. */
const L = ledger(lines);
const names = Object.fromEntries(people.filter((p) => !p.living).map((p) => [p.slug, p.name]));
const towns = new Set(quarters.map((q) => String(q.town).split(",")[0])).size;
const collateral = people.filter((p) => !p.living).length - L.peopleOnLanes - L.peopleInPens;
---
<Base title="The Four Quarters" eyebrow={`${Words(L.lanes)} grandparents, ${words(towns)} towns`}
      dek="Every person has four grandparents, and they are the honest unit of a family history: four separate families, four separate depths of evidence, and no reason at all for them to be equal.">

  <p class="note">These four were born within eight years of each other — 1920, 1924, 1925, 1928 —
  in three towns that had no connection whatsoever. Two of them are about {FURTHEST_KM} kilometres
  apart. All four were in Queensland by 1954.</p>

  <section class="blk" style="margin-top:28px">
    <div class="lab">The lines, drawn</div>
    <h2 style="margin-top:.4rem">How far back each line is proved</h2>
    <figure class="rivers" style="margin:1rem 0 0">
      <BranchRivers rivers={lines} title={lines.title} caption={lines.caption} names={names} />
    </figure>
    <p class="small" style="margin-top:.8rem;color:var(--ink-2)">{Words(L.lanes)} lines drawn, with {L.peopleOnLanes} people on them
    and {L.peopleInPens} more in the pens under them. The other {collateral} people who have died are in the archive but not on this drawing: a line is a
    chain of direct ancestors, and these are the people around it, the brothers and sisters, cousins and married-in families, and the few
    entered in the tree and joined to nobody. {Words(L.tiers.documented || 0)} of the lines
    are documented all the way up, {words(L.tiers.inferred || 0)} stands on the family tree above its oldest document and
    {words(L.tiers["origin-unknown"] || 0)} stops at a wall. <a href={u("/components/")}>The pieces →</a></p>
  </section>

  <div class="stack" style="margin-top:38px">
    {quarters.map((q) => (
      <div>
        <div class="linerow">
          <div>
            <div class="lab">{q.town}</div>
            <div style="font-size:28px;line-height:1.15;margin-top:8px">
              <a href={u("/people/" + q.grandparent.slug)} style="color:inherit">{q.grandparent.name}</a>
            </div>
            <div class="mono" style="margin-top:6px;color:var(--ink-3)">
              {[q.grandparent.born, q.grandparent.died].filter(Boolean).join("–")}
            </div>
          </div>
          <div>
            <div class="meta" style="margin-bottom:12px">
              <span><b>{q.depth}</b> generations deep</span>
              <span>reaches <b>{q.reach || "—"}</b></span>
              <span><b>{q.line.length}</b> in the direct chain</span>
            </div>
            <div class="evlist">
              {q.line.map((r) => (
                <div><b>{r.born || "····"}</b>
                  <a href={u("/people/" + r.slug)}>{r.name}</a></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <section class="blk" style="margin-top:20px">
    <div class="lab">Where {words(walls.length)} of the lines stop, and why</div>
    <h2 style="margin-top:.4rem">{Words(walls.length)} walls, {words(walls.length)} different reasons</h2>
    <div class="prose" style="margin-top:1rem">
      <p>Every wall below ends a line at a named person, and <strong>none of them ends because
      nobody looked</strong>. Each wall was established by reading until the absence was
      provable — a province probed year by year, a register that begins in 1823, a
      volume opened to find nine years physically missing. <strong>A wall established by reading is a
      finding. A wall assumed from silence is a shrug</strong>, and the difference is most of what
      this archive is for.</p>
    </div>
    <div class="stack" style="margin-top:26px">
      {walls.map((w) => (
        <div>
          <div class="linerow">
            <div>
              <div class="lab">{w.quarter}</div>
              <div style="font-size:24px;line-height:1.2;margin-top:8px">{w.person}</div>
              <div class="mono" style="margin-top:6px;color:var(--ink-3)">{w.born} · {w.town}</div>
              <div class="mono" style="margin-top:10px;color:var(--ink-3);font-size:11px">established {w.established}</div>
            </div>
            <div>
              <p style="margin:0 0 10px;font-weight:600">{w.reason}</p>
              <p class="small" style="margin:0 0 10px;color:var(--ink-2);line-height:1.6">{w.evidence}</p>
              <div class="lab" style="margin-top:12px">what is left</div>
              <p class="small" style="margin:4px 0 0;color:var(--ink-2)">{w.route}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="blk" style="margin-top:20px">
    <div class="lab">Where the chart stops and the evidence does not</div>
    <h2 style="margin-top:.4rem">{beyond + below} people no chart on this site can draw</h2>
    <div class="prose" style="margin-top:1rem">
      <p>Every chart here is drawn from Michael's export, so a person the family tree does not
      contain cannot appear on one — however good the act behind them. <strong>{beyond} ancestors and {below} children are
      proved by a register and invisible on every picture.</strong> The line below each name is where
      the drawing stops; everything under it is what the records actually say stands above.</p>
      <p class="note">This is not a flaw in the charts. It is the difference between what a family
      remembers and what an archive can prove, and it is the single largest gap left on this site.</p>
    </div>

    <div class="stack" style="margin-top:26px">
      {anchors.map(([slug, v]) => (
        <div>
          <div class="lab">the chart stops at</div>
          <div style="font-size:22px;line-height:1.2;margin-top:6px">
            <a href={u("/people/" + slug)} style="color:inherit">{v.exportName}</a>
            {v.anchor !== v.exportName && <span class="mono" style="color:var(--ink-3);font-size:14px"> · the archive calls him {v.anchor}</span>}
          </div>
          <div class="evlist" style="margin-top:12px">
            {(v.down || []).map((r) => (
              <div>
                <b>{r.born && r.born !== "\u2014" ? r.born : "····"}</b>
                <strong>{r.name}</strong>
                <span class="mono" style="color:var(--ink-3)"> · a documented child</span>
                <div class="small" style="color:var(--ink-3)">{r.source}</div>
              </div>
            ))}
            {v.up.map((r) => (
              <div>
                <b>{r.born && r.born !== "\u2014" ? r.born : "····"}</b>
                <strong>{r.name}</strong>
                <span class="mono" style="color:var(--ink-3)"> · {r.rel}</span>
                {r.trade && r.trade !== "\u2014" && <em> · {r.trade}</em>}
                <div class="small" style="color:var(--ink-3)">{r.source}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="blk" style="margin-top:20px">
    <h2>The quarters are not equal, and that is the finding</h2>
    <p class="dek" style="margin-top:.8rem">One quarter reaches {Math.min(...quarters.map((q) => q.reach))} and {words(Math.max(...quarters.map((q) => q.line.length)))} generations. Another
    stops after {words(stopsShort.line.length)}, at a man with no dates at all. This is not because one family was more
    important — it is because <strong>Calabrian civil registration survives better than Sicilian</strong>
    for these particular comuni, and because the Briatico line has been worked on by relatives in
    Italy and Argentina for years while the Sicilian line has not.
    Depth of pedigree measures the archive, not the ancestors.</p>
  </section>
</Base>
