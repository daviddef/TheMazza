---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import spellings from "../data/place-spellings.json";
import places from "../data/places.json";
const byCountry = {};
for (const p of places) {
  const c = /Queensland|New South Wales|Victoria|Western Australia|Australia/.test(p.name) ? "Australia"
    : /New York|New Jersey|Louisiana|Florida|USA|United States/.test(p.name) ? "United States"
    : /Argentina/.test(p.name) ? "Argentina"
    : /Great Britain|England/.test(p.name) ? "United Kingdom" : "Italy";
  (byCountry[c] ||= []).push(p);
}
const order = ["Italy", "Australia", "United States", "Argentina", "United Kingdom"];
import atlas from "../../public/atlas-data.json";
---
<Base title="Places" eyebrow={`${places.length} places`}
      dek="Every place this archive can attach to a person, with the years it covers and how many events fall there.">
  {order.filter((c) => byCountry[c]).map((c) => (
    <section class="blk">
      <h2>{c}</h2>
      <div class="scroll" style="margin-top:16px">
        <table>
          <thead><tr><th>Place</th><th class="m">Events</th><th class="m">Born</th><th class="m">Died</th><th class="m">Buried</th><th class="m">Span</th></tr></thead>
          <tbody>{byCountry[c].map((p) => (
            <tr><td>{p.name}</td><td class="m">{p.n}</td><td class="m">{p.born || ""}</td>
                <td class="m">{p.died || ""}</td><td class="m">{p.buried || ""}</td>
                <td class="m">{p.first ? `${p.first}–${p.last}` : ""}</td></tr>))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="blk" style="border-bottom:0">
    <div class="lab">Four names, normalised</div>
    <h2 style="margin-top:.4rem">Why one town was three places</h2>
    <div class="prose" style="margin-top:1rem">
      <p>Scilla appeared in the export three times — as <em>Scillla</em> with three l's, as
      <em>Scilla</em> bare, and as <em>Scilla, Reggio Calabria</em> — so the map drew one dot and left
      two empty places beside it. Soriano Calabro was spelt <em>Sorianno</em>. Both are keystrokes,
      not claims about the family, so they are normalised when the places are built.</p>
      <p><strong>Nothing is edited silently.</strong> Every substitution is listed here, and the
      export itself is untouched.</p>
    </div>
    <div class="scroll" style="margin-top:16px">
      <table>
        <thead><tr><th>As the export writes it</th><th>As the map needs it</th><th>Why</th></tr></thead>
        <tbody>
          {spellings.map((r) => (
            <tr>
              <td class="m"><strong>{r.asWritten}</strong></td>
              <td class="m">{r.corrected}</td>
              <td class="small">{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note" style="margin-top:18px"><strong>And one coordinate set by hand.</strong> Soriano
    Calabro is not in the estate gazetteer, and asking for &ldquo;Soriano Calabro, Italy&rdquo; returns
    <strong>Soriano nel Cimino in Lazio</strong> — four hundred kilometres north, a different town
    with a similar name. The comune in Vibo Valentia is at 38.5969, 16.2304, and that coordinate is
    recorded in <code>data/gazetteer-local.json</code> with its source, because <strong>a dot in the
    wrong province is worse than no dot</strong>.</p>
  </section>

<section class="blk" id="every-place">
  <h2>Every place with a page of its own</h2>
  <p class="dek">One page per place the atlas can put a person in, listing who was born, married or
    buried there and what the archive read to know it. These were reachable only by clicking a marker
    on the map, which meant a reader without JavaScript — and a search engine — could not get to any
    of them.</p>
  <p class="placelist">{atlas.places.filter((p) => p.slug).sort((a, b) =>
      (a.place || a.name || "").localeCompare(b.place || b.name || "")).map((p, i) => (
    <>{i > 0 && <span class="sep"> · </span>}<a href={u(`/places/${p.slug}/`)}>{p.place || p.name}</a></>
  ))}</p>
</section>
</Base>
