---
/* ONE PAGE PER PERSON (23 November 2026). A name this archive holds a person for has no page of its own any more: the person's page is
   /people/<slug>/, it lists the other people who carry the same name, and the old address /who/<name>/ is a static redirect to it
   (astro.config.mjs, from lib/namesets.js: one bearer -> that person's page, a shared name -> its first bearer's page at
   #others-of-this-name).

   What is still drawn here is the NAME PAGE of a person READ from register acts who is in no family file (src/data/read-names.json,
   tools/read_names.py): there is no person page to send it to, and this page says where the name was read and never says two
   acts are one man or one woman. */
import Base from "../../layouts/Base.astro";
import ReadName from "../../components/ReadName.astro";
import { u } from "../../lib/url.js";
import readNames from "../../data/read-names.json";
import { SETS } from "../../lib/namesakes.js";

export function getStaticPaths() {
  /* a read name whose slug a person's name already has would be a redirect, not a page here (check_read_names.py forbids it) */
  return [
    ...readNames.names.filter((n) => !SETS.has(n.slug)).map((n) => ({ params: { slug: n.slug }, props: { name: n.name, read: n } })),
  ];
}

const { name, read } = Astro.props;
---
<Base title={name}
      eyebrow="A name read from the registers"
      dek={`${name} is in a register act and in no family file here. This page says where the name was read.`}>
  <section class="blk">
    <ReadName name={name} aliases={read.aliases} records={read.records} pages={readNames.pages} />
    <p class="dek" style="margin-top:1.6rem">A name is not a person. This page does not say that the acts above
    are one man or one woman — see <a href={u("/method/#ladder")}>how this archive grades what it says</a>.</p>
  </section>
</Base>
