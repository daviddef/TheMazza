---
/* Every name in the archive, and how many people bore it. One page per person (23 November 2026): a name no longer has a page of its
   own, so each entry here goes straight to the person page(s) of that name: one link for a name one person bears, and every bearer
   listed for a name several people bear. The names READ from register acts and held in no family file keep a page each (below). */
import Base from "../../layouts/Base.astro";
import NameLists from "@daviddef/archive-kit/components/NameLists.astro";
import EveryName from "@daviddef/archive-kit/components/EveryName.astro";
import { u } from "../../lib/url.js";
import readNames from "../../data/read-names.json";
import { SETS, firstBearer, isShared, bearersOf, SECTION_ID } from "../../lib/namesakes.js";
import { hasSection } from "../../lib/namesets.js";

const esc = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
const names = [...SETS.values()].map((s) => {
  const first = firstBearer(s);
  return {
    slug: s.key, name: s.name, n: s.people.length,
    href: u(`/people/${first.slug}/`) + (hasSection(s, first) ? `#${SECTION_ID}` : ""),
    /* every bearer of a shared name, each a link to that person's own page, told apart by the years of their life and the place; a living
       person is "a living person" and their town and nothing more */
    detail: isShared(s)
      ? bearersOf(s).map((b) => {
          const text = b.living ? "a living person" : (b.life ? esc(b.life) : "no dates");
          return `<a href="${esc(b.href)}">${esc(b.name)}</a> <span class="cap">${text}${b.where ? ", " + esc(b.where) : ""}</span>`;
        }).join("<br>")
      : "",
  };
}).sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
const shared = names.filter((n) => n.n > 1);
/* EveryName draws each name as a link to /who/<slug>/; hand it the person page instead */
const hrefOf = new Map(names.map((n) => [`/who/${n.slug}/`, n.href]));
const toPerson = (p) => hrefOf.get(p) ?? u(p);
/* names read from register acts, in no family file: n is the number of ACTS, not of people */
const read = readNames.names.map((r) => ({
  slug: r.slug, name: r.name, n: r.records.length,
  detail: r.records.map((x) => x.act).slice(0, 3).join("; ") + (r.records.length > 3 ? "; …" : ""),
})).sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Every Name"
      eyebrow={`${names.length} names · ${shared.length} held by more than one person · ${read.length} more read from the registers`}
      dek="A name is not a person. This is every name in the archive, and how many different people bore it. Each links to the person: a name more than one person bears lists them all — and, below it, the names the registers give that no family file holds.">

<NameLists here="who" u={u} />


  <section class="blk">
    <EveryName names={names} u={toPerson} detailLabel="Everyone of this name" />
  </section>

  <section class="blk" id="read">
    <h2>Read from the registers</h2>
    <p class="dek" style="margin:.7rem 0 1.2rem">{read.length} names that a register act gives — a mother, a witness, the officer who
    received the act — and that no family file holds. Each has a page that says where the name was read. The
    number is the number of acts, and an act is not a person: two acts are never called one man on a name alone.</p>
    <EveryName names={read} u={u} counts="records" noun="names read from the registers" detailLabel="Read in" />
  </section>
</Base>
