---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
/* every public asset gets a fingerprint, so a fix is never served stale */
const v = versioner();
import { u } from "../lib/url.js";
import { FAMILY_MENU } from "../lib/familylist.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import BookHead from "@daviddef/archive-kit/components/BookHead.astro";
import BookFoot from "@daviddef/archive-kit/components/BookFoot.astro";
import book from "../data/book.json";
import ring from "@daviddef/archive-kit/data/archives.json";
/* `ownHeading` is for a page whose content draws its own h1 and its one sentence (the shared people page,
   kit PersonPage: it carries the name, the life dates and the sentence inside its own header). Base then
   renders no page head, so the document keeps exactly one h1, and `dek` is used for the description only. */
const { title, description = "", dek, eyebrow, bare, noindex, ownHeading = false, autolink = false } = Astro.props;
/* THE BUILD-TIME NAME LINKER (kit/tools/autolink.py, run by `npm run autolink`) links the first mention of each
   name that resolves to one dead person, in every <main> it is allowed into. It is allowed into a page only when
   the page says so (<Base autolink>): the twelve long research narratives. Every other page, the person and name
   pages, the registers, the logs, the lists, keeps data-no-autolink on <main> and is left exactly as written. */
const SITE = "The Mazza Archive";
const nav = [
  ["Start", [["/", "Home"], ["/story/", "The story"], ["/about/", "About"], ["/trees/", "The trees"], ["/tree/", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline/", "The Timeline"], ["/lines/", "The Four Quarters"]]],
  ["Our line", [["/direct-line/", "The Spine"], ["/ancestors/", "The Ancestors"], ["/the-name-line/", "The Mazza Name Line"], ["/crossings/", "The Crossings"]]],
  ["The families", [["/marriages/", "The Marriages"], ["/the-hundred-and-ten/", "The Hundred and Ten"], ["/components/", "The Pieces"]]],
  ["People & places", [["/people/", "The People"], ["/bloodline/", "Blood relatives, drawn"], ["/who/", "Every Name"], ["/register/", "The Register"], ["/households/", "Households"], ["/places/", "Places"], ["/nudgee/", "Nudgee"], ["/piedimonte-etneo/", "Piedimonte Etneo"], ["/briatico/", "Briatico"], ["/scilla/", "Scilla"], ["/brisbane/", "Brisbane"]]],
  /* The family pages. The list is src/lib/familylist.js; the landing page at defranceski.com
     builds its chips for this archive from this group, so a family page that is not in it
     does not appear there. */
  ["The name", [["/name/", "The Name"], ...FAMILY_MENU]],
  ["Evidence", [["/method/", "Method"], ["/sources/", "Sources"], ["/searched/", "What Has Been Read"], ["/open-questions/", "Open Questions"], ["/errands/", "Errands"], ["/worklist/", "The work list"], ["/corrections/", "Corrections"], ["/changes/", "What changed"], ["/documents/", "Documents"]]],
  ["Investigations", [["/register-1879/", "The Sicilian Registers"], ["/queensland/", "The Queensland Register"], ["/audit/", "The Audit"], ["/briatico-tested/", "Testing the 1697"]]],
];

const here = Astro.url.pathname.replace(/\/$/, "");
const on = (h) => here === u(h).replace(/\/$/, "");
/* WHICH OF THE SEVEN THIS IS, and it must not be answered by `base` any more.
   Every archive that moves to its own domain gets base "", and six of the seven
   now have. `find(a => a.base === "")` returns the FIRST of them, which is the
   Defranceschi archive — so this line was about to hand this page somebody
   else's accent colour and, through VisitCount below, SOMEBODY ELSE'S
   GOATCOUNTER SITE. That is not hypothetical: on 12 October 2026
   lerena.defranceski.com and darcy.defranceski.com were both logging their
   pageviews to thedefranceski.goatcounter.com, because they still ask this
   question the old way.
   whoami() settles it on the ORIGIN — it matches import.meta.env.SITE against
   each entry's url — which is why astro.config's `site` and the ring's url for
   this archive have to agree, and now do. */
/* This is whoami()'s logic from the kit's lib/ring.js, inlined. The kit module
   cannot be imported here as a bare specifier: it does `import ring from
   "../data/archives.json"` with no `with { type: "json" }`, and Node's ESM
   loader refuses that during static generation. SocialHead gets away with it
   because Vite resolves its relative import. Inlined rather than patched so
   that six other archives do not have to be re-pinned for a one-line fix. */
const originOf = (x) => { try { return new URL(x).origin; } catch { return ""; } };
const SITE_ORIGIN = originOf(import.meta.env.SITE || "");
const onBase = ring.archives.filter(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
const thisArchive =
  (SITE_ORIGIN && onBase.find((a) => originOf(a.url) === SITE_ORIGIN)) || onBase[0];
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek || description} />
<SocialHead title={title} description={dek || description} site={SITE} />
{!noindex && <JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />}
    {noindex && <meta name="robots" content="noindex" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Mazza <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search the archive">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={on(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}</div>
  </div>
</header>
<BookHead book={book} u={u} />

<main id="main" tabindex="-1" data-no-autolink={autolink ? undefined : ""}>
  <div class="wrap">
    {!bare && !ownHeading && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>
<BookFoot book={book} u={u} />

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first archive of the Mazza family of Piedimonte Etneo in Sicily —
    and of Briatico and Scilla in Calabria, of New York and Buenos Aires, and of Brisbane. Every claim
    carries its confidence, or is marked as unproven. A living person (80 or younger, with no death recorded) is named with their relationships and their town and country, and nothing more.</p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/documents/")}>Documents</a> ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/corrections/")}>For Michael — the corrections</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      <a href="https://github.com/daviddef/TheMazza">The repository</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
</body>
</html>
