{
  "name": "mazza-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4326",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run nameevidence && npm run components && npm run focus && npm run additions && npm run plates && npm run records && npm run readnames && npm run trove && npm run nicotra && npm run docline && npm run docparents && npm run audit && npm run disputed && npm run coverage && npm run holdings && npm run instruments && npm run sources && npm run questions && npm run walls && npm run lines && npm run familylines && npm run searched && npm run graves && npm run atlas && astro build && npm run searchindex && astro build && npm run names && npm run autolink && npm run sitemap && npm run check:book && npm run check:lines && npm run check:living && npm run check:living-v2 && npm run check:living-v2:selftest && npm run check:prose && npm run check:kin && npm run check:links && npm run check:story && npm run check:story:selftest && npm run check:directline && npm run check:familyribbon && npm run check:additions && npm run check:grades && npm run check:corrections && npm run check:places && npm run check:searched && npm run check:nils && npm run check:order && npm run check:worklist && npm run check:covers && npm run check:templates && npm run check:kit && npm run check:sources && npm run check:pages && npm run check:inline && npm run check:plates && npm run check:arks && npm run check:shown && npm run check:rows && npm run check:nav && npm run check:familypages && npm run check:familypages:selftest && npm run check:autolink && npm run check:autolinks && npm run check:autolink:selftest && npm run check:rec && npm run check:rec:selftest && npm run check:readnames && npm run check:readnames:selftest && npm run check:era-ground && npm run check:era && npm run check:era:selftest",
    "preview": "astro preview --port 4326",
    "names": "python3 ../tools/build_names_index.py",
    "autolink": "python3 node_modules/@daviddef/archive-kit/kit/tools/autolink.py --dist dist --index .autolink/names-index.json --living ../private/living.json --allow-prefix /people/ --allow-prefix /who/",
    "check:autolink": "python3 node_modules/@daviddef/archive-kit/kit/tools/checklinks.py --dist dist --index .autolink/names-index.json --living ../private/living.json --allow-prefix /people/ --allow-prefix /who/ --floor .linkfloor.json",
    "check:autolinks": "python3 ../tools/check_autolinks.py",
    "check:autolink:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/autolink_selftest.py",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "searchindex": "python3 ../tools/searchindex.py",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare --years --config standard.json --strict-allow",
    "check:living-v2": "python3 ../tools/check_living_v2.py --dist dist --data src/data --root ..",
    "check:living-v2:selftest": "python3 ../tools/check_living_v2.py --selftest --dist dist --data src/data --root ..",
    "check:prose": "python3 ../tools/check_prose.py",
    "check:prose-strict": "python3 ../tools/check_prose.py --require-tree",
    "searched": "python3 ../tools/build_searched.py",
    "graves": "python3 ../tools/build_graves.py",
    "additions": "python3 ../tools/build_additions.py",
    "docline": "python3 ../tools/build_documented_line.py",
    "docparents": "python3 ../tools/build_documented_parents.py",
    "audit": "python3 ../tools/build_audit.py",
    "disputed": "python3 ../tools/build_disputed.py",
    "coverage": "python3 ../tools/build_coverage.py",
    "holdings": "python3 ../tools/build_holdings.py",
    "instruments": "python3 ../tools/build_instruments.py",
    "sources": "python3 ../tools/build_sources.py",
    "questions": "python3 ../tools/build_questions.py",
    "lines": "python3 ../tools/build_lines.py",
    "check:lines": "python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --lines src/data/lines.json --dist ${ARCHIVE_OUT:-dist} --config standard.json --living ../private/living-slugs.json && python3 node_modules/@daviddef/archive-kit/kit/tools/checklines.py --selftest",
    "walls": "python3 ../tools/build_walls.py",
    "check:links": "python3 ../tools/check_links.py",
    "check:story": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilystory.py --story src/data/story.json --dist ${ARCHIVE_OUT:-dist} --person-base /people/ --living ../private/living.json",
    "check:story:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilystory.py --selftest",
    "check:additions": "python3 ../tools/check_additions.py",
    "check:grades": "python3 ../tools/check_grades.py --max-gaps 4",
    "check:corrections": "python3 ../tools/check_corrections.py",
    "check:places": "python3 ../tools/check_places.py",
    "check:searched": "python3 ../tools/check_searched.py",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "check:nils": "python3 ../tools/check_nils.py --max-flagged 11",
    "check:order": "python3 ../tools/check_order.py --strict",
    "check:sources": "python3 node_modules/@daviddef/archive-kit/kit/tools/checksources.py --root . --max-unreachable 13",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 0",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist dist --book src/data/book.json",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist dist --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 5",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root .",
    "nicotra": "python3 ../tools/build_nicotra.py",
    "components": "cd .. && python3 tools/build_components.py",
    "focus": "cd .. && python3 tools/build_focus.py",
    "nameevidence": "cd .. && python3 tools/build_nameevidence.py",
    "plates": "python3 ../tools/build_plates.py",
    "check:plates": "python3 ../tools/check_plates.py",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --data src/data/people.json --born born --died died --max 0",
    "trove": "python3 ../tools/build_trove.py",
    "check:shown": "python3 ../tools/check_shown.py",
    "check:arks": "python3 ../tools/check_arks.py",
    "check:familypages": "python3 ../tools/check_familypages.py",
    "check:familypages:selftest": "python3 ../tools/check_familypages.py --selftest",
    "records": "python3 ../tools/build_records.py",
    "readnames": "python3 ../tools/read_names.py",
    "check:readnames": "python3 ../tools/check_read_names.py",
    "check:rec": "python3 ../tools/check_rec.py",
    "check:rec:selftest": "python3 ../tools/check_rec.py --selftest",
    "check:era-ground": "python3 ../tools/build_era.py --check",
    "check:era": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkera.py --dist dist --snapshot src/data/era-snapshot.json --living-urls ../private/living.json --require-tracked --rulers",
    "check:era:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/era_selftest.py",
    "check:readnames:selftest": "python3 ../tools/check_read_names.py --selftest",
    "familylines": "python3 ../tools/build_family_lines.py",
    "check:directline": "python3 node_modules/@daviddef/archive-kit/kit/tools/directline.py --story src/data/story.json --check src/data/direct-line.json",
    "check:familyribbon": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilyribbon.py --families src/data/family-lines.json --direct src/data/direct-line.json --story src/data/story.json --dist ${ARCHIVE_OUT:-dist} --lines src/data/lines.json && python3 node_modules/@daviddef/archive-kit/kit/tools/checkfamilyribbon.py --selftest"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#d88b11e914e433d9d2c6bd750b8d8e707d1a0b65",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
