{
  "name": "mazza-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4326",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run additions && npm run searched && npm run graves && npm run atlas && astro build && npm run searchindex && astro build && npm run sitemap && npm run check:living && npm run check:links && npm run check:additions && npm run check:kit",
    "preview": "astro preview --port 4326",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "searchindex": "python3 ../tools/searchindex.py",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare",
    "searched": "python3 ../tools/build_searched.py",
    "graves": "python3 ../tools/build_graves.py",
    "additions": "python3 ../tools/build_additions.py",
    "check:links": "python3 ../tools/check_links.py",
    "check:additions": "python3 ../tools/check_additions.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#b16bea79b56a5f27e84b25271575b2919639544e",
    "astro": "^5.18.2"
  }
}
